      "settings": {
        "name": "GazeCamera",
        "id": 0,
        "w": 640,
        "h": 480,
        "rate": {
          "fps": 15,
          "downsampling": 1
        },
        "fourCC": "MJPG",
        "encoding": {
          "codec": "JPG",
          "compression": 80
        },
        "rotationAngle": 0,
        "flip": {
          "horizontal": false,
          "vertical": false
        },
        "crop": {
          "enabled": false,
          "x": 0,
          "y": 0,
          "w": 200,
          "h": 200
        },
        "scale": 1.0
      },
      "x": 80,
      "y": 120
    },
    {
      "id": "gaze",
      "nodeNumber": 2,
      "type": "N2uCore.dyn.eyegaze.GazeDirection",
      "sysinit": "SysInit",
      "settings": {
        "name": "GazeDino"
      },
      "x": 440,
      "y": 120
