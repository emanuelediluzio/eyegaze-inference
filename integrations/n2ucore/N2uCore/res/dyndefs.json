{
  "N2uCore.dyn.eyegaze.GazeDirection": {
    "group": "/Inference Models/Eye Gaze",
    "module": "N2uCore.dyn.eyegaze",
    "class": "GazeDirection",
    "label": "Gaze Direction",
    "description": "RGB face to gaze yaw/pitch, landmark-derived head roll and unit 3D gaze vector. Fixed GazeDINO model, automatic compute device, up to 15 FPS.",
    "PROPS_SCHEMA": {},
    "inputs": [
      {
        "name": "VideoStream",
        "type": "VIDEO_VISIBLE"
      }
    ],
    "outputs": [
      {
        "name": "GazeDirection",
        "type": "TEXT"
      }
    ],
    "commands": {}
  },
  "N2uCore.dyn.screenpointofgaze.ScreenPointOfGaze": {
    "group": "/Inference Models/Eye Gaze",
    "module": "N2uCore.dyn.screenpointofgaze",
    "class": "ScreenPointOfGaze",
    "label": "Screen Point of Gaze",
    "description": "Maps upstream gaze direction to screen pixels after session-only guided calibration. No saved calibration files or neural model.",
    "PROPS_SCHEMA": {},
    "inputs": [
      {
        "name": "GazeDirection",
        "type": "TEXT"
      }
    ],
    "outputs": [
      {
        "name": "ScreenPoint",
        "type": "TEXT"
      }
    ],
    "commands": {
      "calibrationStatus": {
        "name": "calibrationStatus",
        "label": "calibrationStatus",
        "args": {}
      },
      "getCalibration": {
        "name": "getCalibration",
        "label": "getCalibration",
        "args": {}
      },
      "beginCalibration": {
        "name": "beginCalibration",
        "label": "beginCalibration",
        "args": {
          "screen_w": {
            "type": "INT",
            "min": 2
          },
          "screen_h": {
            "type": "INT",
            "min": 2
          }
        }
      },
      "calibrationTarget": {
        "name": "calibrationTarget",
        "label": "calibrationTarget",
        "args": {
          "x": {
            "type": "FLOAT",
            "min": 0
          },
          "y": {
            "type": "FLOAT",
            "min": 0
          }
        }
      },
      "finishTarget": {
        "name": "finishTarget",
        "label": "finishTarget",
        "args": {}
      },
      "fitCalibration": {
        "name": "fitCalibration",
        "label": "fitCalibration",
        "args": {}
      },
      "cancelCalibration": {
        "name": "cancelCalibration",
        "label": "cancelCalibration",
        "args": {}
      }
    }
  }
}
